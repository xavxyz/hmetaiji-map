{
  "name": "hmetaiji-map",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode page",
    "build:lib": "vite build",
    "build:page": "vite build --mode page",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "mapbox-gl": "^3.12.0"
  },
  "volta": {
    "node": "24.19.0"
  },
  "lint-staged": {
    "*.{ts,js,json,css,html,md,yml,yaml}": "prettier --write"
  }
}
