VITE_MAPBOX_TOKEN=   # Mapbox access token
VITE_SHEET_ID=       # Google Spreadsheet ID (sheet must be publicly readable)
VITE_GROUPS_GID=276965013     # gid of the groups tab (optional; disables groups layer if absent)

# Assigned inline in the Netlify build command (see netlify.toml), never by
# hand: they feed the non-production build badge.
VITE_DEPLOY_CONTEXT= # Netlify $CONTEXT (empty locally -> no badge)
VITE_BRANCH=         # Netlify $BRANCH (the branch built)
